# Copy this file to .env and fill in your own values.
# Never commit the real .env file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# NVIDIA NIM (RAG assistant)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBED_MODEL=nvidia/nemotron-3.5-embed-8b
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Pinecone vector store (RAG knowledge index)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=bookstore-rag
PINECONE_HOST=your-index-host.pinecone.io
PINECONE_API_VERSION=2025-04
